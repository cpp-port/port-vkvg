diff --git a/vkh/src/vkh_queue.c b/vkh/src/vkh_queue.c
--- a/vkh/src/vkh_queue.c
+++ b/vkh/src/vkh_queue.c
@@ -44,1 +44,9 @@
+void vkh_queue_set_host_synchronization(
+    VkhQueue queue, void *userData, vkh_queue_host_sync_callback_t lockCallback,
+    vkh_queue_host_sync_callback_t unlockCallback) {
+    queue->hostSyncUserData = userData;
+    queue->hostSyncLock     = lockCallback;
+    queue->hostSyncUnlock   = unlockCallback;
+}
+
 void vkh_queue_destroy(VkhQueue queue) { free(queue); }
