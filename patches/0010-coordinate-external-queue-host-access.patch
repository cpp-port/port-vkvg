+static VkResult _vkh_queue_submit(VkhQueue queue, uint32_t submitCount,
+                                  const VkSubmitInfo *submitInfo, VkFence fence) {
+    if (queue->hostSyncLock)
+        queue->hostSyncLock(queue->hostSyncUserData);
+
+    VkResult result = vkQueueSubmit(queue->queue, submitCount, submitInfo, fence);
+
+    if (queue->hostSyncUnlock)
+        queue->hostSyncUnlock(queue->hostSyncUserData);
+    return result;
+}
