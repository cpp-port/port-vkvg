+    // Eight 45-degree cubics: k = 4/3 * tan(pi/16). Two semicircle
+    // cubics bulge by 1.835% of the radius, visibly rotating against raster rings.
+    // Fixed endpoints make the final endpoint exactly equal to the first.
+    static const float unit[9][2] = {
+        {0.0f, -1.0f}, {0.7071067811865475f, -0.7071067811865475f},
+        {1.0f, 0.0f}, {0.7071067811865475f, 0.7071067811865475f},
+        {0.0f, 1.0f}, {-0.7071067811865475f, 0.7071067811865475f},
