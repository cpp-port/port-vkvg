+void _curve_to(VkvgContext ctx, float x1, float y1, float x2, float y2, float x3, float y3) {
+    // _add_point stores device-space points, but subdivision and its control
+    // points are in user space. Undo mat1 here so subdivision applies it once.
+    vec2 cp = {x1, y1};
+    if (!_current_path_is_empty(ctx)) {
+        cp = _get_current_position(ctx);
+        vkvg_matrix_t inverse = ctx->mat1;
+        if (vkvg_matrix_invert(&inverse) != VKVG_STATUS_SUCCESS) {
+            ctx->status = VKVG_STATUS_INVALID_MATRIX;
+            return;
+        }
+        vkvg_matrix_transform_point(&inverse, &cp.x, &cp.y);
+    }
+
+    // prevent running _recursive_bezier when all 4 curve points are equal
+    if (EQUF(x1, x2) && EQUF(x2, x3) && EQUF(y1, y2) && EQUF(y2, y3)) {
+        if (_current_path_is_empty(ctx) || (EQUF(cp.x, x1) && EQUF(cp.y, y1)))
+            return;
+    }
+    ctx->simpleConvex = false;
+    _set_curve_start(ctx);
+    if (_current_path_is_empty(ctx))
+        _add_point(ctx, x1, y1);
+
